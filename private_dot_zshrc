# History
setopt SHARE_HISTORY
setopt HIST_VERIFY
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_DUPS
export HISTSIZE=1000000000
export HISTFILESIZE=1000000000
export SAVEHIST=1000000000
export HISTFILE=~/.zsh_history


# Sourcing
source ~/.zsh_alias
source ~/.zsh_functions
source ~/.zsh_functions_private
fpath=( ~/.zfunc "${fpath[@]}" )

bindkey -e

# Options
setopt AUTO_CD
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
setopt NO_CLOBBER

# Skim
zle     -N   skim-history-widget
bindkey '^R' skim-history-widget
zle -N skim-cd-widget
bindkey '^S' skim-cd-widget
setopt noflowcontrol

# mise
eval "$(mise activate zsh)"

# Sheldon
eval "$(sheldon source)"

# Option/Alt+Left/Right → word motion, enhanced-keyboard-mode encoding.
# In legacy mode Kitty sends \e\e[D and zimfw/input binds it. But when a TUI
# (neovim/fzf/lazygit) enables Kitty's keyboard protocol and exits uncleanly,
# it leaves the protocol pushed and Option+arrow switches to the CSI-modifier
# form \e[1;3D, which nothing binds — so the trailing D/C leaks. Bind that form
# here (after sheldon) so word-motion works regardless of Kitty's current mode.
bindkey "^[[1;3D" backward-word   # Option+Left
bindkey "^[[1;3C" forward-word    # Option+Right


autoload bashcompinit && bashcompinit
complete -C "$(which aws_completer)" aws
complete -o nospace -C "$(which terraform)" terraform
complete -o nospace -o default -o bashdefault -F _az_python_argcomplete "az"

# Make "kubecolor" borrow the same completion logic as "kubectl"
compdef kubecolor=kubectl

# Oh My Posh prompt — fall back to a plain theme on raw VT consoles (no Nerd Font)
if [[ "$TERM" == "linux" ]]; then
  eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/config-tty.toml)"
else
  eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/config.toml)"
fi

[ -r ~/.zshrc.ansible ] && source ~/.zshrc.ansible
